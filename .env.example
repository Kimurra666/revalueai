# Leave unset (or "true") to use mock data from /mocks.
# Set to "false" and point NEXT_PUBLIC_API_BASE_URL at the backend to use real endpoints.
NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Show the scenario switcher in production builds too (it always shows in `npm run dev`).
NEXT_PUBLIC_SHOW_DEV_TOGGLE=false
